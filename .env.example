# ==============================================================================
# FULL BACK — Environment Variables Configuration Template
# Copy this file to .env and fill in the details for local deployment.
# ==============================================================================

# Sports Data API Key (API-Football or football-data.org)
# Default is empty; if empty, the server falls back to mock sports data.
SPORTS_DATA_API_KEY=7df76826ac8c5455c4cf0e8308cee056

# Injective Protocol Network Configuration
# Testnet RPC and EVM/Cosmos private key for signing CCTP and on-chain interactions.
INJECTIVE_PRIVATE_KEY=your_injective_private_key_here
INJECTIVE_RPC=https://testnet.sentry.chain.injective.network:443

# x402 Micropayments Configuration
# Wallet address that will receive client micro-payments.
X402_WALLET_ADDRESS=0x0000000000000000000000000000000000000000
X402_SECRET_KEY=your_x402_secret_key_here

# Python microservice connection URL
# Node MCP server uses this URL to trigger K-Means clustering and audio processing.
PYTHON_SERVICE_URL=http://localhost:8000
